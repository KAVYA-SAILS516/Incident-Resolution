# Copy to backend/.env. Never commit .env or credential files.
# Authentication uses Application Default Credentials: run `gcloud auth application-default login`.
# No API key is needed or read.

# Required for the two ADK agents (Vertex AI)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash      # VERTEX_MODEL is accepted as an alias

# AI provider: 'vertex' (Gemini on Vertex AI) is the only real provider; there is no silent fallback.
# AI_PROVIDER=vertex

# Optional (defaults shown)
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_ATTEMPTS=4
# AUTO_ANALYZE=true
# MAX_CONCURRENT_ANALYSES=4
# DETECTION_WINDOW_MINUTES=10
# DETECTION_MIN_OCCURRENCES=5
# ENDPOINT_FAMILY_DEPTH=1
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATA_DIR=../data

# Application discovery (optional): when set, scanned application paths must be inside this directory.
# APPLICATION_ROOT=C:\incident-data

# OpenTelemetry runtime (optional). The application's Collector exports to a telemetry backend; these are the
# query endpoints of that backend (the OpenTelemetry Astronomy Shop uses OpenSearch, Jaeger and Prometheus).
# OTEL_ENABLED=true
# OTEL_ENDPOINT=http://localhost:4317            # the Collector's OTLP endpoint (informational)
# OTEL_LOGS_URL=http://localhost:9200            # OpenSearch holding the Collector's logs
# OTEL_LOGS_INDEX=otel-logs*
# OTEL_TRACES_URL=http://localhost:16686/jaeger/ui  # Jaeger query API base; publish the Shop's Jaeger port 16686
# OTEL_METRICS_URL=http://localhost:9090         # Prometheus
# OTEL_LOOKBACK_MINUTES=30

# Resolution / verification
# REMEDIATION_MAX_ATTEMPTS=2
# VERIFICATION_WAIT_SECONDS=60

# The one monitored application (scanned at startup) and legacy file import (leave off)
# APPLICATION_NAME=OpenTelemetry Astronomy Shop
# ASTRONOMY_SHOP_PATH=C:\incident-data\astronomy-shop   # APPLICATION_PATH is accepted as an alias
# FILE_LOG_INGEST=false
# PRIORITY_P1_MIN=80
# PRIORITY_P2_MIN=65
# PRIORITY_P3_MIN=50

# Metric-based detection (Prometheus span metrics). Defaults shown; an anomalous 30 s step needs >= METRIC_MIN_REQUESTS
# spans in the window, and the detector's usual DETECTION_MIN_OCCURRENCES steps to open an incident.
# METRIC_DETECTION=true
# METRIC_WINDOW_SECONDS=120
# METRIC_STEP_SECONDS=30
# METRIC_MIN_REQUESTS=3
# METRIC_ERROR_RATIO_MIN=0.25
# METRIC_LATENCY_MIN_MS=1000
# METRIC_LATENCY_FACTOR=3

# Automatic telemetry reading: seconds between background reads (0 = only the Read Telemetry button).
# TELEMETRY_POLL_SECONDS=60
